<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trabajo Interfaz</title>
    <style>
        .formulario label {
            display: block;
        }

        .inline {
            display: inline !important;
        }
    </style>
</head>
<body>
    <form class="formulario">
        <label>
            Nombre:
            <input name="nombre" type="text" maxlength="200" required>
        </label>
        <label>
            E-mail:
            <input name="email" type="email" maxlength="200" required>
        </label>
        <label>
            Quiero recibir publicidad
            <input type="checkbox" name="publicidad" checked value="yes">
        </label>
        <label>
        		Asunto: 
            <input name="asunto" type="text" maxlength="200" required>
        </label>
        <label>
        		Contenido:
            <input name="contenido" type="text" maxlength="1000" required>
        </label>    
        <button type="submit">Enviar</button>
    </form>
</body>
</html>
